\@writefile{lof}{\contentsline {figure}{\numberline {10.1}{\ignorespaces Schema concettuale del voting. L’input $x$ viene fornito a più modelli ($d_1, d_2, \dots  , d_L$), le cui predizioni vengono combinate tramite una somma pesata per produrre l’output finale $y$.}}{94}{figure.caption.92}\protected@file@percent }
\newlabel{fig:voting}{{10.1}{94}{Schema concettuale del voting. L’input $x$ viene fornito a più modelli ($d_1, d_2, \dots , d_L$), le cui predizioni vengono combinate tramite una somma pesata per produrre l’output finale $y$}{figure.caption.92}{}}
\@writefile{toc}{\contentsline {paragraph}{Osservazione}{94}{section*.93}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {10.2}Mixture of Experts}{94}{section.10.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10.2}{\ignorespaces Schema del modello di mixture of experts. L’input $x$ viene fornito sia ai modelli di base ($d_1, \dots  , d_L$) sia alla funzione di gating, che determina dinamicamente i pesi con cui le singole predizioni vengono combinate per produrre l’output finale $y$.}}{95}{figure.caption.94}\protected@file@percent }
\newlabel{fig:mixture_experts}{{10.2}{95}{Schema del modello di mixture of experts. L’input $x$ viene fornito sia ai modelli di base ($d_1, \dots , d_L$) sia alla funzione di gating, che determina dinamicamente i pesi con cui le singole predizioni vengono combinate per produrre l’output finale $y$}{figure.caption.94}{}}
\@writefile{toc}{\contentsline {section}{\numberline {10.3}Stacking}{95}{section.10.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10.3}{\ignorespaces Schema dello stacking. L’input $x$ viene fornito a più modelli di base ($d_1, d_2, \dots  , d_L$), le cui predizioni sono utilizzate come input di un meta–modello $f(\cdot )$ che apprende come combinarle per produrre l’output finale $y$.}}{96}{figure.caption.95}\protected@file@percent }
\newlabel{fig:stacking}{{10.3}{96}{Schema dello stacking. L’input $x$ viene fornito a più modelli di base ($d_1, d_2, \dots , d_L$), le cui predizioni sono utilizzate come input di un meta–modello $f(\cdot )$ che apprende come combinarle per produrre l’output finale $y$}{figure.caption.95}{}}
\@writefile{toc}{\contentsline {section}{\numberline {10.4}Cascading}{96}{section.10.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10.4}{\ignorespaces Schema del cascading. L’input $x$ viene elaborato da una sequenza di modelli. Ogni modello restituisce una predizione solo se la sua confidenza supera una soglia prefissata; in caso contrario, l’input viene passato al modello successivo.}}{97}{figure.caption.96}\protected@file@percent }
\newlabel{fig:cascading}{{10.4}{97}{Schema del cascading. L’input $x$ viene elaborato da una sequenza di modelli. Ogni modello restituisce una predizione solo se la sua confidenza supera una soglia prefissata; in caso contrario, l’input viene passato al modello successivo}{figure.caption.96}{}}
\@writefile{toc}{\contentsline {section}{\numberline {10.5}Bagging}{97}{section.10.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {10.6}Boosting}{98}{section.10.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10.5}{\ignorespaces Schema concettuale del boosting. A ogni iterazione $m$, il modello $y_m(x)$ viene addestrato su un dataset pesato $\{w_n^{(m)}\}$. I pesi dei campioni mal classificati vengono aumentati, costringendo i learner successivi a concentrarsi sugli errori precedenti. La predizione finale è una combinazione pesata delle predizioni dei singoli modelli.}}{99}{figure.caption.97}\protected@file@percent }
\newlabel{fig:boosting}{{10.5}{99}{Schema concettuale del boosting. A ogni iterazione $m$, il modello $y_m(x)$ viene addestrato su un dataset pesato $\{w_n^{(m)}\}$. I pesi dei campioni mal classificati vengono aumentati, costringendo i learner successivi a concentrarsi sugli errori precedenti. La predizione finale è una combinazione pesata delle predizioni dei singoli modelli}{figure.caption.97}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.6.1}AdaBoost}{99}{subsection.10.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10.6}{\ignorespaces Evoluzione di AdaBoost al crescere del numero di iterazioni $m$. I cerchi più grandi indicano campioni con peso maggiore. I weak learner successivi si concentrano progressivamente sui punti difficili, producendo una frontiera di decisione sempre più articolata.}}{100}{figure.caption.99}\protected@file@percent }
\newlabel{fig:adaboost}{{10.6}{100}{Evoluzione di AdaBoost al crescere del numero di iterazioni $m$. I cerchi più grandi indicano campioni con peso maggiore. I weak learner successivi si concentrano progressivamente sui punti difficili, producendo una frontiera di decisione sempre più articolata}{figure.caption.99}{}}
