\newlabel{fig:regularization_effects}{{7.4}{76}{Effetto della regolarizzazione su un modello polinomiale di grado elevato ($M=9$). In alto è mostrata la soluzione non regolarizzata, caratterizzata da forti oscillazioni e overfitting}{figure.caption.70}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.5}{\ignorespaces Una regolarizzazione debole ($\ln \lambda = -18$), che consente una buona approssimazione della funzione target.}}{77}{figure.caption.71}\protected@file@percent }
