\@writefile{lof}{\contentsline {figure}{\numberline {9.1}{\ignorespaces  Classificazione K-NN con $K=3$. Per ciascun punto di query ($x_1$, $x_2$) vengono selezionati i tre campioni più vicini nel dataset; la classe assegnata è quella di maggioranza tra i vicini. La decisione è locale e dipende fortemente dalla distribuzione dei punti nello spazio delle feature. }}{87}{figure.caption.81}\protected@file@percent }
\newlabel{fig:knn_k3}{{9.1}{87}{Classificazione K-NN con $K=3$. Per ciascun punto di query ($x_1$, $x_2$) vengono selezionati i tre campioni più vicini nel dataset; la classe assegnata è quella di maggioranza tra i vicini. La decisione è locale e dipende fortemente dalla distribuzione dei punti nello spazio delle feature}{figure.caption.81}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9.2}{\ignorespaces  Tassellazione di Voronoi indotta da un classificatore 1-NN ($K=1$). Ogni punto del dataset genera una regione dello spazio contenente tutti i punti più vicini a esso rispetto a qualunque altro campione. La frontiera di decisione risulta altamente irregolare e perfettamente adattata ai dati di training. }}{87}{figure.caption.82}\protected@file@percent }
\newlabel{fig:voronoi_k1}{{9.2}{87}{Tassellazione di Voronoi indotta da un classificatore 1-NN ($K=1$). Ogni punto del dataset genera una regione dello spazio contenente tutti i punti più vicini a esso rispetto a qualunque altro campione. La frontiera di decisione risulta altamente irregolare e perfettamente adattata ai dati di training}{figure.caption.82}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.1.1}Effetto del parametro $K$ sulle regioni di decisione}{88}{subsection.9.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.3}{\ignorespaces  Effetto dell’aumento del parametro $K$ nel classificatore K-NN. Da sinistra a destra: $K=1$, $K=3$, $K=31$. All’aumentare di $K$, le regioni di decisione diventano progressivamente più lisce, riducendo la complessità del modello e l’overfitting. }}{88}{figure.caption.83}\protected@file@percent }
\newlabel{fig:knn_increasing_k}{{9.3}{88}{Effetto dell’aumento del parametro $K$ nel classificatore K-NN. Da sinistra a destra: $K=1$, $K=3$, $K=31$. All’aumentare di $K$, le regioni di decisione diventano progressivamente più lisce, riducendo la complessità del modello e l’overfitting}{figure.caption.83}{}}
