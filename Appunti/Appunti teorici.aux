\@writefile{toc}{\contentsline {section}{\numberline {7.1}Modelli lineari per funzioni lineari}{74}{section.7.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces Esempio di regressione lineare bidimensionale. I punti blu rappresentano i valori target osservati, affetti da rumore, mentre la retta rossa corrisponde alla funzione di predizione $y(x;w)=w_0+w_1x_1$ appresa dal modello. I segmenti verticali indicano i residui, ovvero gli errori $t_n - y(x_n;w)$ che vengono minimizzati nel criterio dei minimi quadrati.}}{75}{figure.caption.67}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:linear_fit}{{7.1}{75}{Esempio di regressione lineare bidimensionale. I punti blu rappresentano i valori target osservati, affetti da rumore, mentre la retta rossa corrisponde alla funzione di predizione $y(x;w)=w_0+w_1x_1$ appresa dal modello. I segmenti verticali indicano i residui, ovvero gli errori $t_n - y(x_n;w)$ che vengono minimizzati nel criterio dei minimi quadrati}{figure.caption.67}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7.2}Modelli lineari con basis functions}{75}{section.7.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces Esempio di regressione mediante basis functions polinomiali di diverso grado $M$. I punti blu rappresentano i dati osservati, la curva verde indica la funzione target sottostante, mentre la curva rossa corrisponde alla funzione appresa dal modello. All’aumentare del grado del polinomio cresce la flessibilità del modello, passando da situazioni di underfitting ($M=0,1$) a una buona approssimazione ($M=3$), fino a fenomeni di overfitting ($M=9$).}}{76}{figure.caption.68}\protected@file@percent }
\newlabel{fig:polynomial_basis}{{7.2}{76}{Esempio di regressione mediante basis functions polinomiali di diverso grado $M$. I punti blu rappresentano i dati osservati, la curva verde indica la funzione target sottostante, mentre la curva rossa corrisponde alla funzione appresa dal modello. All’aumentare del grado del polinomio cresce la flessibilità del modello, passando da situazioni di underfitting ($M=0,1$) a una buona approssimazione ($M=3$), fino a fenomeni di overfitting ($M=9$)}{figure.caption.68}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces  Visualizzazione grafica di alcuni esempi di basis function.}}{77}{figure.caption.69}\protected@file@percent }
\newlabel{fig:polynomial_basis}{{7.3}{77}{Visualizzazione grafica di alcuni esempi di basis function}{figure.caption.69}{}}
