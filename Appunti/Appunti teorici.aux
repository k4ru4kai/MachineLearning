\@writefile{lof}{\contentsline {figure}{\numberline {9.1}{\ignorespaces Schema concettuale del voting. L’input $x$ viene fornito a più modelli ($d_1, d_2, \dots  , d_L$), le cui predizioni vengono combinate tramite una somma pesata per produrre l’output finale $y$.}}{86}{figure.caption.79}\protected@file@percent }
\newlabel{fig:voting}{{9.1}{86}{Schema concettuale del voting. L’input $x$ viene fornito a più modelli ($d_1, d_2, \dots , d_L$), le cui predizioni vengono combinate tramite una somma pesata per produrre l’output finale $y$}{figure.caption.79}{}}
\@writefile{toc}{\contentsline {paragraph}{Osservazione}{86}{section*.80}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {9.2}Mixture of Experts}{86}{section.9.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.2}{\ignorespaces Schema del modello di mixture of experts. L’input $x$ viene fornito sia ai modelli di base ($d_1, \dots  , d_L$) sia alla funzione di gating, che determina dinamicamente i pesi con cui le singole predizioni vengono combinate per produrre l’output finale $y$.}}{87}{figure.caption.81}\protected@file@percent }
\newlabel{fig:mixture_experts}{{9.2}{87}{Schema del modello di mixture of experts. L’input $x$ viene fornito sia ai modelli di base ($d_1, \dots , d_L$) sia alla funzione di gating, che determina dinamicamente i pesi con cui le singole predizioni vengono combinate per produrre l’output finale $y$}{figure.caption.81}{}}
\@writefile{toc}{\contentsline {section}{\numberline {9.3}Stacking}{87}{section.9.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.3}{\ignorespaces Schema dello stacking. L’input $x$ viene fornito a più modelli di base ($d_1, d_2, \dots  , d_L$), le cui predizioni sono utilizzate come input di un meta–modello $f(\cdot )$ che apprende come combinarle per produrre l’output finale $y$.}}{88}{figure.caption.82}\protected@file@percent }
\newlabel{fig:stacking}{{9.3}{88}{Schema dello stacking. L’input $x$ viene fornito a più modelli di base ($d_1, d_2, \dots , d_L$), le cui predizioni sono utilizzate come input di un meta–modello $f(\cdot )$ che apprende come combinarle per produrre l’output finale $y$}{figure.caption.82}{}}
\@writefile{toc}{\contentsline {section}{\numberline {9.4}Cascading}{88}{section.9.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.4}{\ignorespaces Schema del cascading. L’input $x$ viene elaborato da una sequenza di modelli. Ogni modello restituisce una predizione solo se la sua confidenza supera una soglia prefissata; in caso contrario, l’input viene passato al modello successivo.}}{89}{figure.caption.83}\protected@file@percent }
\newlabel{fig:cascading}{{9.4}{89}{Schema del cascading. L’input $x$ viene elaborato da una sequenza di modelli. Ogni modello restituisce una predizione solo se la sua confidenza supera una soglia prefissata; in caso contrario, l’input viene passato al modello successivo}{figure.caption.83}{}}
\@writefile{toc}{\contentsline {section}{\numberline {9.5}Bagging}{89}{section.9.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {9.6}Boosting}{90}{section.9.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.5}{\ignorespaces Schema concettuale del boosting. A ogni iterazione $m$, il modello $y_m(x)$ viene addestrato su un dataset pesato $\{w_n^{(m)}\}$. I pesi dei campioni mal classificati vengono aumentati, costringendo i learner successivi a concentrarsi sugli errori precedenti. La predizione finale è una combinazione pesata delle predizioni dei singoli modelli.}}{91}{figure.caption.84}\protected@file@percent }
\newlabel{fig:boosting}{{9.5}{91}{Schema concettuale del boosting. A ogni iterazione $m$, il modello $y_m(x)$ viene addestrato su un dataset pesato $\{w_n^{(m)}\}$. I pesi dei campioni mal classificati vengono aumentati, costringendo i learner successivi a concentrarsi sugli errori precedenti. La predizione finale è una combinazione pesata delle predizioni dei singoli modelli}{figure.caption.84}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.6.1}AdaBoost}{91}{subsection.9.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.6}{\ignorespaces Evoluzione di AdaBoost al crescere del numero di iterazioni $m$. I cerchi più grandi indicano campioni con peso maggiore. I weak learner successivi si concentrano progressivamente sui punti difficili, producendo una frontiera di decisione sempre più articolata.}}{92}{figure.caption.86}\protected@file@percent }
\newlabel{fig:adaboost}{{9.6}{92}{Evoluzione di AdaBoost al crescere del numero di iterazioni $m$. I cerchi più grandi indicano campioni con peso maggiore. I weak learner successivi si concentrano progressivamente sui punti difficili, producendo una frontiera di decisione sempre più articolata}{figure.caption.86}{}}
